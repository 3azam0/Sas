# Local-only demonstration sessions. Keep disabled in production.
SAAS_DEMO_MODE=1
SAAS_APP_ORIGIN=http://127.0.0.1:3108
# Production starts use .cache/local-config.json and .data-local.
# Development uses port 3109 and .data-dev; SAAS_PORT overrides dev only.
# PGlite is single-process development storage, not production SaaS hosting.
# SAAS_DATA_DIR=/absolute/path/to/local/runtime
# Copy these public settings into apps/web/.env.local for the selected cloud project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Production Auth, tenant schema and PowerSync are not implemented yet.
